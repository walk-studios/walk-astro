---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Memphis Web Design & Development | Walk Studios"
  description="Custom websites for Memphis businesses. Built from code, not templates, with SEO structure and copy included. Pricing starts at $2,000."
  canonical="/"
