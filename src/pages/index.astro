            <div class="flex-grow border-b-2 border-black ml-2"></div>
            <div class="w-11 h-11 bg-black text-white text-2xl flex justify-center items-center ml-2 my-4" aria-hidden="true">T</div>
          </div>
          <div class="mx-11">
            <div class="aspect-[4/3] w-full overflow-hidden">
