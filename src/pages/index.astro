              </div>
            </div>
            <div class="w-20 bg-black text-white font-bold text-4xl flex justify-center items-center min-h-[50px]" aria-hidden="true">W</div>
          </div>
        </div>
      </a>

      <!-- MSCC -->
      <a href="/mscc" class="block w-full max-w-md mx-auto">
        <div class="bg-slate-100/80 min-w-full min-h-full flex flex-col">
          <div class="mx-11 pt-5 flex items-center">
            <p class="text-2xl font-bold">Mid-South Construction Careers</p>
            <div class="flex-grow border-b-2 border-black ml-2"></div>
            <div class="w-11 h-11 bg-black text-white text-2xl flex justify-center items-center ml-2 my-4" aria-hidden="true">M</div>
          </div>
          <div class="mx-11">
            <div class="aspect-[4/3] w-full overflow-hidden">
              <img
                class="w-full h-full object-cover"
                src="/Images/mscc-hero.webp"
                alt=""
