          </div>
          <div class="mx-11 py-6 flex justify-between">
            <div class="flex-grow border-t-2 border-black">
              <div class="flex flex-wrap gap-x-3 gap-y-1" aria-hidden="true">
                <p>Web Design</p>
                <p>Web Development</p>
              </div>
            </div>
