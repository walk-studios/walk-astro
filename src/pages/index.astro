            </div>
          </div>
          <div class="mx-11 py-6 flex justify-between">
            <div class="flex-grow border-t-2 border-black">
              <div class="flex flex-wrap gap-x-3 gap-y-1" aria-hidden="true">
                <p>Web Development</p>
                <p>SEO</p>
                <p>Content Strategy</p>
              </div>
            </div>
            <div class="w-20 bg-black text-white font-bold text-4xl flex justify-center items-center min-h-[50px]" aria-hidden="true">W</div>
          </div>
        </div>
      </a>

      <!-- 767 Agency -->
      <a href="/767" class="block w-full max-w-md mx-auto">
        <div class="bg-slate-100/80 min-w-full min-h-full flex flex-col">
          <div class="mx-11 pt-5 flex items-center">
            <p class="text-2xl font-bold">767 Agency</p>
            <div class="flex-grow border-b-2 border-black ml-2"></div>
            <div class="w-11 h-11 bg-black text-white text-2xl flex justify-center items-center ml-2 my-4" aria-hidden="true">7</div>
          </div>
          <div class="mx-11">
            <div class="aspect-[4/3] w-full overflow-hidden">
              <img
                class="w-full h-full object-cover"
                src="/Images/Frame_1.jpg"
                alt=""
                loading="lazy"
              />
            </div>
          </div>
          <div class="mx-11 py-6 flex justify-between">
            <div class="flex-grow border-t-2 border-black">
              <div class="flex flex-wrap gap-x-3 gap-y-1" aria-hidden="true">
                <p>Web Design</p>
                <p>Web Development</p>
                <p>Logo Design</p>
              </div>
            </div>
            <div class="w-20 bg-black text-white font-bold text-4xl flex justify-center items-center min-h-[50px]" aria-hidden="true">W</div>
          </div>
        </div>
      </a>

      <!-- Salo Pallini -->
      <a href="/salo" class="block w-full max-w-md mx-auto">
        <div class="bg-slate-100/80 min-w-full min-h-full flex flex-col">
          <div class="mx-11 pt-5 flex items-center">
            <p class="text-2xl font-bold">Salo Pallini</p>
            <div class="flex-grow border-b-2 border-black ml-2"></div>
            <div class="w-11 h-11 bg-black text-white text-2xl flex justify-center items-center ml-2 my-4" aria-hidden="true">S</div>
          </div>
          <div class="mx-11">
            <div class="aspect-[4/3] w-full overflow-hidden">
              <img
                class="w-full h-full object-cover"
                src="/Images/salo-hero.webp"
                alt=""
                loading="lazy"
              />
            </div>
          </div>
          <div class="mx-11 py-6 flex justify-between">
            <div class="flex-grow border-t-2 border-black">
              <div class="flex flex-wrap gap-x-3 gap-y-1" aria-hidden="true">
                <p>Web Design</p>
                <p>Web Development</p>
