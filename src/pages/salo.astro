---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Walk Studios | Salo Pallini"
  description="Cinematic musician site for Memphis-based artist Salo Pallini — Ecwid e-commerce integration for vinyl sales, streaming links, and a visual identity that matches the music."
  canonical="/salo"
  darkNav={true}
>
  <div class="overflow-hidden">
    <div class="w-screen flex flex-col items-center bg-black">
      <div class="pt-28 px-6 pb-4 w-full">
        <a
          href="/projects"
          class="text-sm font-medium text-walk-red hover:text-white transition-colors duration-150"
        >
          ← All Projects
        </a>
      </div>
      <div class="max-w-[1440px] m-0 sm:mt-4">

        <!-- Hero image -->
        <div class="flex flex-col">
          <div>
            <img
              class="mx-0 w-full"
              src="/Images/salo-hero.webp"
              width="1268"
              height="925"
              alt="Salo Pallini musician website homepage"
              loading="eager"
            />
          </div>
        </div>

        <!-- Project details -->
        <div class="bg-white">
          <div class="flex flex-col md:flex-row mx-4 md:mx-9 pt-4">
            <div class="flex flex-col md:flex-1">
              <h1 class="text-5xl md:text-9xl mb-4 mt-5">Salo Pallini</h1>
              <p class="text-2xl sm:text-4xl pt-4 sm:pt-8">
                Salo Pallini is a Memphis-based musician and composer whose
                work spans cinematic scoring, vinyl releases, and live
                performance.
              </p>
            </div>
            <div class="md:flex-1 pt-11 sm:pt-0">
              <div class="flex-1 md:flex md:justify-end sm:mr-11 sm:mt-11 mb-4">
                <div class="flex flex-col sm:items-center">
                  <p class="text-3xl md:text-4xl mb-4 font-medium">Services</p>
                  <p class="text-xl md:text-2xl">Web Design</p>
                  <p class="text-xl md:text-2xl">Web Development</p>
                  <p class="text-xl md:text-2xl">E-commerce Integration</p>
                  <a
                    href="https://salopallini.com"
                    class="mt-6 inline-block w-fit bg-walk-red shadow-md px-3.5 py-2.5 text-center text-lg font-semibold text-white hover:bg-walk-red/70 hover:scale-105 duration-100"
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    Salo Pallini
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Project description -->
          <div class="py-11 sm:py-20 sm:mt-14 flex flex-col items-center px-6 sm:px-8">
            <p class="sm:w-2/3 md:pb-4 text-xl sm:text-2xl">
              Built on Next.js with Ecwid e-commerce integration for vinyl
              sales, streaming platform links, and a shows page. The visual
              design leads with full-bleed imagery and restrained typography
              to let the artist's work speak. Sanity CMS integration scoped
              for the shows page to make tour dates self-manageable without
              developer involvement.
            </p>
            <p class="sm:w-2/3 mt-6 text-sm uppercase tracking-widest text-gray-500">
              Stack: Next.js · Tailwind · Ecwid · Netlify
            </p>
          </div>
        </div>

        <!-- Supporting image -->
        <div class="bg-gray-100 flex justify-center py-8">
          <img
            class="w-2/3"
            src="/Images/salo-detail.webp"
            width="1283"
            height="877"
            alt="Salo Pallini musician website detail view"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </div>

  <div class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-16 flex justify-between items-center border-t border-gray-200">
      <a href="/767" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
        ← 767 Agency
      </a>
      <a href="/mscc" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
        MSCC →
      </a>
    </div>
  </div>
</BaseLayout>
