---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Walk Studios | Project My Music Industry"
  description="Case study for MyMusicIndustry — a platform connecting music professionals with industry experts."
  canonical="/mma"
  darkNav={true}
>
  <div class="overflow-hidden">
    <div class="w-screen flex flex-col items-center bg-black">
      <div class="max-w-[1400px] m-0 mt-24 sm:mt-4">
        <img src="/Images/image_1_case_study.jpg" width="1600" height="800" priority alt="Title slide for case study of My Music Industry" loading="eager" class="w-full" />
        <img width="1600" height="800" src="/Images/gif1.gif" alt="Gif image of mobile use of the My Music Industry app" loading="lazy" class="w-full" />
        <img src="/Images/image3_case_study.png" width="1600" height="800" alt="Problem statement, objectives, process stages, and business challenges for My Music Industry" loading="lazy" class="w-full" />
        <img src="/Images/image4_case_study.png" width="1600" height="800" alt="Mobile app page designs" loading="lazy" class="w-full" />
        <img src="/Images/image5_case_study.png" width="1600" height="800" alt="Competitor analysis and user persona for My Music Industry" loading="lazy" class="w-full" />
        <img src="/Images/image6_case_study.png" width="1600" height="800" alt="Design explorations for My Music Industry" loading="lazy" class="w-full" />
        <img src="/Images/image7_case_study.png" width="1600" height="800" alt="Product users and quantitative research findings" loading="lazy" class="w-full" />
        <img src="/Images/image8_case_study.png" width="1600" height="800" alt="Design system and component library" loading="lazy" class="w-full" />
        <img width="1600" height="800" src="/Images/gif2.gif" alt="Gif image of mobile use of the My Music Industry app" loading="lazy" class="w-full" />
        <img src="/Images/image9_case_study.png" width="1600" height="800" alt="Taskflows for two user scenarios in My Music Industry" loading="lazy" class="w-full" />
      </div>
    </div>
  </div>
</BaseLayout>
