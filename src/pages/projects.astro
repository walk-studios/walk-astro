          <h1 class="text-7xl md:text-8xl text-walk-red md:font-semibold tracking-tight">
            The work speaks for itself.
          </h1>
          <p class="w-full ml-1 text-2xl md:text-4xl text-left leading-10 mt-4 mr-6">
            Each project is built from scratch — no templates, no shortcuts.
          </p>
        </div>

        <div class="container ml-8 flex justify-center pt-24">
          <div class="cube">
            <div class="iso top"></div>
            <div class="iso bottom"></div>
            <div class="iso left"></div>
            <div class="iso right"></div>
            <div class="iso front"></div>
            <div class="iso back"></div>
          </div>
        </div>
        <br />
      </div>
    </div>

