          </div>
        </div>
      </a>

    </div>
  </div>

  <script>
    const cubeQuery = document.querySelector('.cube');

    if (cubeQuery instanceof HTMLElement) {
      const cube: HTMLElement = cubeQuery;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let rotX = 0;
      let rotY = 0;
      let currentRotX = 0;
      let currentRotY = 0;
      let animFrameId: number | null = null;

      function autoRotate() {
        if (isDragging) return;
        rotY += 0.3;
        rotX += 0.15;
        cube.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
        animFrameId = requestAnimationFrame(autoRotate);
      }

      cube.addEventListener('pointerdown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        currentRotX = rotX;
        currentRotY = rotY;
        cube.setPointerCapture(e.pointerId);
        cube.style.cursor = 'grabbing';
        if (animFrameId) cancelAnimationFrame(animFrameId);
        e.preventDefault();
      });

      cube.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        rotY = currentRotY + deltaX * 0.5;
        rotX = currentRotX - deltaY * 0.5;
        cube.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      });

      cube.addEventListener('pointerup', () => {
        isDragging = false;
        cube.style.cursor = 'grab';
        autoRotate();
      });

      cube.addEventListener('pointercancel', () => {
        isDragging = false;
        cube.style.cursor = 'grab';
        autoRotate();
      });

      // Remove CSS animation entirely — JS handles all rotation
      cube.style.animation = 'none';

      // Start auto-rotation on load
      autoRotate();
    }
  </script>
</BaseLayout>
