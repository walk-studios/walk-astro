---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Walk Studios | TradePathHub"
  description="A 2,800+ URL Next.js platform built solo — ISR, Sanity CMS, affiliate system, and real organic search traffic."
  canonical="/tradpathhub"
>
  <div class="overflow-hidden">
    <div class="w-screen flex flex-col items-center bg-white">
      <div class="pt-28 px-6 pb-4 w-full">
        <a
          href="/projects"
          class="text-sm font-medium text-walk-red hover:text-black transition-colors duration-150"
        >
          ← All Projects
        </a>
      </div>
      <div class="max-w-[1440px] m-0 sm:mt-4">

        <!-- Hero image -->
        <div class="flex flex-col">
          <div>
            <img
              class="mx-0 w-full"
              src="/Images/tph-hero.webp"
              width="1258"
              height="879"
              alt="TradePathHub salary data platform homepage"
              loading="eager"
            />
          </div>
        </div>

        <!-- Project details -->
        <div class="bg-white">
          <div class="flex flex-col md:flex-row mx-4 md:mx-9 pt-4">
            <div class="flex flex-col md:flex-1">
              <h1 class="text-5xl md:text-9xl mb-4 mt-5">TradePathHub</h1>
              <p class="text-2xl sm:text-4xl pt-4 sm:pt-8">
                TradePathHub is an independent skilled trades career
                information platform covering salary data, apprenticeship
                programs, and aptitude test preparation across six trades
                and 21 metros.
              </p>
            </div>
            <div class="md:flex-1 pt-11 sm:pt-0">
              <div class="flex-1 md:flex md:justify-end sm:mr-11 sm:mt-11 mb-4">
                <div class="flex flex-col sm:items-center">
                  <p class="text-3xl md:text-4xl mb-4 font-medium">Services</p>
                  <p class="text-xl md:text-2xl">Web Development</p>
                  <p class="text-xl md:text-2xl">SEO</p>
                  <p class="text-xl md:text-2xl">Content Strategy</p>
                  <a
                    href="https://tradepathhub.com"
                    class="mt-6 inline-block w-fit bg-walk-red shadow-md px-3.5 py-2.5 text-center text-lg font-semibold text-white hover:bg-walk-red/70 hover:scale-105 duration-100"
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    TradePathHub
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Project description -->
          <div class="py-11 sm:py-20 sm:mt-14 flex flex-col items-center px-6 sm:px-8">
            <p class="sm:w-2/3 md:pb-4 text-xl sm:text-2xl">
              The platform runs on Next.js 16 with Incremental Static
              Regeneration, a Sanity v3 CMS, and a programmatic content
              architecture that generates 2,800+ URLs from a single data
              layer. Built solo from zero — architecture, content strategy,
              SEO, and an affiliate system — and currently producing real
              organic search traffic.
            </p>
            <p class="sm:w-2/3 mt-6 text-sm uppercase tracking-widest text-gray-500">
              Stack: Next.js 16 · Sanity v3 · AWS Amplify · Tailwind v4 · ISR
            </p>
          </div>
        </div>

        <!-- Supporting image -->
        <div class="bg-gray-100 flex justify-center py-8">
          <img
            class="w-full md:w-2/3"
            src="/Images/tph-detail.webp"
            width="1238"
            height="959"
            alt="TradePathHub salary data platform detail view"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 py-16 flex justify-between items-center border-t border-gray-200">
    <a href="/projects" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
      ← All Projects
    </a>
    <a href="/767" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
      767 Agency →
    </a>
  </div>
</BaseLayout>
