---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services & Pricing | Walk Studios Memphis Web Design"
  description="Web design, development, and SEO services from Walk Studios. Transparent pricing, no templates, copy strategy included on every project."
  canonical="/services"
>
  <div class="max-w-4xl mx-auto px-6 pt-32 pb-24">

    <!-- Header -->
    <h1 class="text-7xl md:text-8xl font-semibold tracking-tight mb-6">SERVICES</h1>
    <p class="text-2xl md:text-3xl leading-relaxed text-gray-600 mb-20">
      Transparent pricing, no templates, and copy strategy included on every project —
      not an add-on.
    </p>

    <!-- Web Design & Development -->
    <div class="mb-20">
      <h2 class="text-4xl font-semibold mb-2">Web Design & Development</h2>
      <div class="bg-black h-1 w-full mb-8"></div>

      <div class="space-y-8">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Starter</h3>
            <p class="text-gray-600 mb-3">4–5 page static site on Astro + Netlify. Contact form, sitemap, on-page SEO. Content managed via code updates — ideal for businesses whose content doesn't change often.</p>
            <p class="text-sm uppercase tracking-widest text-gray-400">Price scales with page count and integrations.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Starting at $2,000</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Standard</h3>
            <p class="text-gray-600 mb-3">6–8 page CMS-backed site on Next.js + Sanity. Client can update content without developer involvement. Includes blog capability, analytics setup, and copy strategy.</p>
            <p class="text-sm uppercase tracking-widest text-gray-400">Price scales with content types, integrations, and scope.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Starting at $4,000</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Complex Build</h3>
            <p class="text-gray-600 mb-3">Programmatic content at scale, custom architecture, third-party integrations, e-commerce, affiliate systems, or large URL footprints. Scoped per project after discovery.</p>
            <p class="text-sm uppercase tracking-widest text-gray-400">Every complex build starts with a scoping conversation.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Contact for pricing</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Local SEO -->
    <div class="mb-20">
      <h2 class="text-4xl font-semibold mb-2">Local SEO</h2>
      <div class="bg-black h-1 w-full mb-8"></div>

      <div class="space-y-8">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">SEO Audit</h3>
            <p class="text-gray-600">Technical audit, Search Console setup, canonical review, sitemap verification, and a prioritized issue list with recommended fixes.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Starting at $750</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">SEO Jumpstart</h3>
            <p class="text-gray-600">Full audit plus implementation — on-page optimization, Google Business Profile setup, local citation cleanup, and LocalBusiness schema. Everything done, not just recommended.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Starting at $1,500</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Ongoing SEO</h3>
            <p class="text-gray-600">Monthly Search Console monitoring, content strategy, GBP management, and reporting. For businesses that want to grow visibility over time without managing it themselves.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">Starting at $500/mo</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Maintenance Retainers -->
    <div class="mb-20">
      <h2 class="text-4xl font-semibold mb-2">Maintenance & Retainers</h2>
      <div class="bg-black h-1 w-full mb-8"></div>

      <div class="space-y-8">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Basic</h3>
            <p class="text-gray-600">Hosting oversight, uptime monitoring, and up to 2 hours of minor edits per month. For sites that rarely change but need someone watching.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">$150/mo</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Standard</h3>
            <p class="text-gray-600">Everything in Basic plus CMS content updates, performance checks, and up to 4 hours of changes per month. For active businesses that update regularly.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">$400/mo</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-6 border-b border-gray-100">
          <div class="md:col-span-2">
            <h3 class="text-2xl font-semibold mb-2">Growth Partner</h3>
            <p class="text-gray-600">Everything in Standard plus a monthly strategy call, priority turnaround on requests, and analytics review. For businesses that want a consistent technical partner, not just a vendor.</p>
          </div>
          <div class="md:text-right">
            <p class="text-3xl font-semibold">$800/mo</p>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="border-t border-gray-200 pt-16 text-center">
      <p class="text-3xl font-semibold mb-4">Not sure which fits?</p>
      <p class="text-xl text-gray-600 mb-8">Every project starts with a conversation. No commitment, no sales pitch.</p>
      <a
        href="/contact"
        class="inline-block bg-walk-red text-white px-8 py-4 text-lg font-semibold hover:bg-walk-red/70 hover:scale-105 duration-100"
      >
        Let's Talk
      </a>
    </div>

  </div>
</BaseLayout>
