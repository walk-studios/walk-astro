---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Walk Studios | Memphis Web Design"
  description="Get in touch with Walk Studios — Memphis web design and development studio. Let's talk about your project."
  canonical="/contact"
>
  <div class="p-4 mt-24" style="animation: heroFadeIn 0.5s ease-out forwards;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 min-h-screen">

      <!-- Left: contact info -->
      <div class="mt-8 md:mt-20">
        <div>
          <h1 class="text-6xl md:text-8xl flex justify-center font-tokyo-regular text-walk-red">
            LET'S BUILD
          </h1>
          <p class="text-2xl flex justify-center mt-5 md:mt-10 mx-8 md:mx-16 text-walk-blue hover:scale-105 duration-100">
            <a href="mailto:info@walkstudios.com">E&bull; info@walkstudios.com</a>
          </p>
          <p class="text-2xl flex justify-center mx-8 md:mx-16 text-walk-blue hover:scale-105 duration-100">
            <a href="tel:9014886427">P&bull; 901-488-6427</a>
          </p>
          <div class="flex justify-center mx-8 md:mx-16 gap-4">
            <a href="https://instagram.com/walk_studios?igshid=YmMyMTA2M2Y=" target="_blank" rel="noreferrer noopener">
              <img class="w-12 mt-4 hover:scale-105 duration-100" src="/Images/insta.svg" alt="Instagram" width="48" height="48" />
            </a>
            <a href="https://www.facebook.com/walkstudios?mibextid=LQQJ4d" target="_blank" rel="noreferrer noopener">
              <img class="w-12 mt-4 pt-[.15rem] hover:scale-105 duration-100" src="/Images/facebook.svg" alt="Facebook" width="48" height="48" />
            </a>
          </div>
        </div>
        <div class="flex justify-center items-center mt-4 md:mt-11">
          <img
            class="mt-4 md:w-3/4"
            src="/Images/Walk_Logo_2.svg"
            alt="secondary logo that looks like a red crosswalk"
            width="600"
            height="300"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right: Netlify Form -->
      <div>
        <div class="mx-auto max-w-2xl md:mt-28 font-futura-light">
          <!--
            Netlify Forms: add data-netlify="true" and a hidden input with form name.
            Netlify detects this at build time and handles submission routing.
          -->
          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mx-auto mt-16 max-w-xl sm:mt-20"
          >
            <!-- Netlify required hidden fields -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 gap-y-6 gap-x-8">
              <div class="sm:col-span-2">
                <label for="name" class="block text-lg leading-6 text-gray-500">Name</label>
                <div class="mt-2.5">
                  <input
                    type="text"
                    name="name"
                    id="name"
                    autocomplete="given-name"
                    required
                    class="block w-full border-0 py-2 px-3.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-walk-red/60 text-md sm:leading-6"
                  />
                </div>
              </div>

              <div class="sm:col-span-2">
                <label for="email" class="block text-lg leading-6 text-gray-500">Email</label>
                <div class="mt-2.5">
                  <input
                    type="email"
                    name="email"
                    id="email"
                    autocomplete="email"
                    required
                    class="block w-full border-0 py-2 px-3.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-walk-red/60 text-md sm:leading-6"
                  />
                </div>
              </div>

              <div class="sm:col-span-2">
                <label for="message" class="block text-lg leading-6 text-gray-500">Message</label>
                <div class="mt-2.5">
                  <textarea
                    id="message"
                    name="message"
                    rows="4"
                    class="resize-none block w-full border-0 py-2 px-3.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-walk-red/60 text-md sm:leading-6"
                  ></textarea>
                </div>
              </div>
            </div>

            <div class="mt-10">
              <button
                type="submit"
                class="block w-full bg-walk-blue px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-walk-blue/70 hover:scale-105 duration-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                Send
              </button>
            </div>

            <div id="form-success" class="hidden mt-4 text-center text-green-600 text-lg">
              Thank you — we'll be in touch soon.
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="flex justify-center h-40"></div>
  </div>

  <script>
    // Show success message if Netlify redirects back with ?success
    const params = new URLSearchParams(window.location.search);
    if (params.get('success') === 'true') {
      document.getElementById('form-success')?.classList.remove('hidden');
    }
  </script>
</BaseLayout>
