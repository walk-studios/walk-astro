---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Walk Studios | Memphis Web Design Studio"
  description="About Walk Studios, a web development studio in Memphis. Custom sites built to load fast, rank in search, and explain the business clearly. Founded by Brian Peterson."
  canonical="/about"
>
  <div class="pt-32 pb-16 min-h-screen">
    <!-- Top logo watermark + tagline -->
    <div class="relative">
      <img
        class="w-screen left-1/2 transform -translate-x-1/2 opacity-10"
        alt="crosswalk logo watermark"
        src="/Images/Walk_Logo_2.svg"
        width="1200"
        height="400"
        loading="lazy"
      />
      <div class="absolute inset-0 flex flex-row items-center mt-28 md:mt-0">
        <div class="md:mt-12 grid grid-cols-1">
          <h1
            class="mt-12 sm:pt-12 lg:mt-0 lg:pt-0 text-2xl md:text-4xl lg:text-5xl mx-5 md:mx-11"
          >
            Websites that do more than look good
          </h1>
        </div>
      </div>
    </div>

    <div class="max-w-2xl mx-auto px-4">
      <!-- Bio section -->
      <div class="mt-52 lg:mt-40">
        <img
          class="w-full"
          alt="Brian Peterson, founder and developer at Walk Studios"
          src="/Images/Brian.jpg"
          width="800"
          height="600"
          loading="lazy"
        />
        <p class="text-xl text-gray-500 mt-1">Brian Peterson | Founder</p>
        <p class="text-xl text-gray-500 mt-1">B.S. Computer Science, University of Memphis. PMP certified.</p>
        <div class="mt-4 text-lg md:text-xl leading-relaxed space-y-3">
          <p>
            Walk Studios is a web development studio in Memphis. The work
            starts from engineering rather than decoration, which means sites
            get built to load fast, show up in search, and explain the
            business clearly to whoever lands on them.
          </p>
          <p>
            Strategy, development, and search all get handled in one place.
            Search structure is part of the build rather than something
            bolted on after launch, and ongoing SEO work is available when a
            site needs it.
          </p>
          <p>
            The studio also runs TradePathHub, a skilled trades career site
            with a few thousand pages of wage data and search traffic that's
            grown every month since launch.
          </p>
          <p>
            Most clients are small businesses, nonprofits, and creative
            people around Memphis and the Mid-South who need the site to do
            something specific rather than just exist.
          </p>
        </div>
      </div>

      <!-- Services section -->
      <div class="mt-12 mb-16">
        <div class="space-y-12">
          <div>
            <h3 class="text-2xl font-semibold">STRATEGY</h3>
            <div class="bg-black h-1 w-full mt-2 mb-3"></div>
            <ul class="text-2xl space-y-1">
              <li>Branding</li>
              <li>SEO</li>
              <li>Content Strategy</li>
            </ul>
          </div>
          <div>
            <h3 class="text-2xl font-semibold">DESIGN</h3>
            <div class="bg-black h-1 w-full mt-2 mb-3"></div>
            <ul class="text-2xl space-y-1">
              <li>Web</li>
              <li>Graphic</li>
              <li>UX/UI</li>
            </ul>
          </div>
          <div>
            <h3 class="text-2xl font-semibold">DEVELOPMENT</h3>
            <div class="bg-black h-1 w-full mt-2 mb-3"></div>
            <ul class="text-2xl space-y-1">
              <li>Web</li>
              <li>E-commerce Integration</li>
              <li>CMS Integration</li>
              <li>Performance</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-24 flex flex-col items-center text-center px-4">
      <p class="text-2xl md:text-3xl font-semibold">
        Tell me what you're working on.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block bg-walk-red text-white px-6 py-3"
      >
        Let's Talk →
      </a>
    </div>
  </div>
</BaseLayout>
