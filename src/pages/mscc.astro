---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Walk Studios | MSCC"
  description="Marketing site for Mid-South Construction Careers — a Memphis nonprofit pre-apprenticeship program connecting underrepresented candidates with careers in the trades."
  canonical="/mscc"
>
  <div class="overflow-hidden">
    <div class="w-screen flex flex-col items-center bg-white">
      <div class="pt-28 px-6 pb-4 w-full">
        <a
          href="/projects"
          class="text-sm font-medium text-walk-red hover:text-black transition-colors duration-150"
        >
          ← All Projects
        </a>
      </div>
      <div class="max-w-[1440px] m-0 sm:mt-4">

        <!-- Hero image -->
        <div class="flex flex-col">
          <div>
            <img
              class="mx-0 w-full"
              src="/Images/mscc-hero.webp"
              width="1265"
              height="964"
              alt="Mid-South Construction Careers website homepage"
              loading="eager"
            />
          </div>
        </div>

        <!-- Project details -->
        <div class="bg-white">
          <div class="flex flex-col md:flex-row mx-4 md:mx-9 pt-4">
            <div class="flex flex-col md:flex-1">
              <h1 class="text-5xl md:text-9xl mb-4 mt-5">Mid-South Construction Careers</h1>
              <p class="text-2xl sm:text-4xl pt-4 sm:pt-8">
                Mid-South Construction Careers is a Memphis nonprofit
                pre-apprenticeship program connecting underrepresented
                candidates with careers in the construction trades.
              </p>
            </div>
            <div class="md:flex-1 pt-11 sm:pt-0">
              <div class="flex-1 md:flex md:justify-end sm:mr-11 sm:mt-11 mb-4">
                <div class="flex flex-col sm:items-center">
                  <p class="text-3xl md:text-4xl mb-4 font-medium">Services</p>
                  <p class="text-xl md:text-2xl">Web Design</p>
                  <p class="text-xl md:text-2xl">Web Development</p>
                  <a
                    href="https://midsouthconstructioncareers.org"
                    class="mt-6 inline-block w-fit bg-walk-red shadow-md px-3.5 py-2.5 text-center text-lg font-semibold text-white hover:bg-walk-red/70 hover:scale-105 duration-100"
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    MSCC
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Project description -->
          <div class="py-11 sm:py-20 sm:mt-14 flex flex-col items-center px-6 sm:px-8">
            <p class="sm:w-2/3 md:pb-4 text-xl sm:text-2xl">
              The site needed to recruit candidates who may never have
              considered the trades as a career path. Clear program overview,
              YouTube integration, a feature grid communicating program
              benefits, and a mobile-first build optimized for the
              demographic they're reaching. The founder taught construction
              mathematics for the program's first cohort, giving the project
              unusual domain credibility.
            </p>
            <p class="sm:w-2/3 mt-6 text-sm uppercase tracking-widest text-gray-500">
              Stack: Next.js · Tailwind · Netlify
            </p>
          </div>
        </div>

        <!-- Supporting image -->
        <div class="bg-gray-100 flex justify-center py-8">
          <img
            class="w-2/3"
            src="/Images/mscc-detail.webp"
            width="1251"
            height="946"
            alt="Mid-South Construction Careers website detail view"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 py-16 flex justify-between items-center border-t border-gray-200">
    <a href="/salo" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
      ← Salo Pallini
    </a>
    <a href="/looktocook" class="text-sm font-medium text-gray-500 hover:text-black transition-colors duration-150">
      Look to Cook →
    </a>
  </div>
</BaseLayout>
